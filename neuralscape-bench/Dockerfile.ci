# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.11-slim

FROM ${PYTHON_IMAGE} AS wheel-builder

WORKDIR /build
COPY pyproject.toml README.md ./
COPY neuralscape_bench ./neuralscape_bench
COPY icebench ./icebench
COPY trackb ./trackb
COPY static ./static
COPY scripts/service_baseline ./scripts/service_baseline

RUN python -m pip install --no-cache-dir build \
    && python -m build --wheel --outdir /tmp/wheels \
    && test "$(find /tmp/wheels -maxdepth 1 -name 'neuralscape_bench-*.whl' | wc -l)" -eq 1


FROM ${PYTHON_IMAGE} AS runtime

ARG PYTHON_IMAGE
ARG VCS_REF=unknown
LABEL org.opencontainers.image.base.name="${PYTHON_IMAGE}" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY --from=wheel-builder /tmp/wheels/neuralscape_bench-*.whl /tmp/wheels/
RUN python -m pip install --no-cache-dir /tmp/wheels/neuralscape_bench-*.whl \
    && rm -rf /tmp/wheels
COPY scripts/ci_wheel_smoke.py /usr/local/libexec/ci_wheel_smoke.py

WORKDIR /tmp
CMD ["python", "/usr/local/libexec/ci_wheel_smoke.py"]


FROM runtime AS test

RUN python -m pip install --no-cache-dir \
    "pytest>=8.0.0" \
    "pytest-asyncio>=0.23.0"

# Only tests and their fixtures are copied (suites that live inside a package
# and use relative imports run from the installed wheel instead; see
# scripts/ci_run_suite.sh). Package imports must resolve from
# the wheel installed in the runtime stage, never from a source checkout.
COPY tests /test-suite/tests
COPY icebench/tests /test-suite/icebench/tests
COPY icebench/trackq/tests /test-suite/icebench/trackq/tests
COPY icebench/tokensave/tests /test-suite/icebench/tokensave/tests
# The skip gate, its manifest and the shared suite runner (see scripts/ci_run_suite.sh).
COPY ci /test-suite/ci
COPY scripts/ci_skip_gate.py scripts/ci_run_suite.sh /test-suite/scripts/

WORKDIR /test-suite
CMD ["sh", "scripts/ci_run_suite.sh", "/tmp/bench-junit.xml", "/usr/local/libexec/ci_wheel_smoke.py"]
