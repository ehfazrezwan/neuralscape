# Profile: flags-on
# Every compatible opt-in feature on at once, for the THROWAWAY campaign stack only.
# Defaults in the product are never changed by this file; it is the gate's input.
#
# sidecars: nsc-acc-sink
# The gate pulls python:3.12-alpine once; the harness starts/removes the sink itself
# (acceptance/nsaccept/sidecar.py). Its fixed name below is what the stack calls.
#
# Secrets: none is written here. `<generate:KIND>` lines are replaced by the gate
# with a freshly generated value (one value per KEY, the same for the API and
# every worker) before the stack starts. See acceptance/README.md.
#
# Single quotes keep a JSON value literal in a dotenv file.

# -- dictator identity (fixed id; the stack's volumes are throwaway per run) ------
DICTATOR_USER_IDS=acc-dictator
STANDARDS_ENABLED=true
PROCESSES_ENABLED=true

# -- dreaming -----------------------------------------------------------------
DREAMING_ENABLED=true
# Recall tie-break (hard-bounded at 0.1 by the service).
DREAMING_SALIENCE_RECALL_K=0.05
# Destructive actions (INVALIDATE/PRUNE) apply at or above this confidence. The
# product default is 0.85; 0.7 keeps an obviously-superseded fact from landing in
# the shadow report on an LLM that rates it 0.8.
DREAMING_AUTO_APPLY_CONFIDENCE=0.7
STRATEGY_SYNTHESIZER_ENABLED=true

# -- queue-empty webhook -> the sink sidecar on the stack's network -----------------
WEBHOOK_QUEUE_EMPTY_URL=http://nsc-acc-sink:8080/queue-empty

# -- connectors (Fernet vault key generated by the gate) ---------------------------
CONNECTORS_ENABLED=true
VAULT_KEY=<generate:fernet>
# One exact stdio command line is allowlisted so the scenarios can prove both the
# allowed and the refused path. The scenarios never sync an stdio connector.
CONNECTOR_STDIO_COMMANDS=echo acc-allowed-stdio

# -- native code graph over source that is already inside the image ----------------
# /app/neuralscape-service/knowledge is a small package of the service itself.
# (The service root is NOT used: it holds a virtualenv and the native indexer
# walks every *.py under the path it is given.)
CODE_NATIVE_ENABLED=true
CODE_REPOS='{"svc":"/app/neuralscape-service/knowledge"}'
# Lexical (BM25 over symbol cards) locate only: no embedding model download.
CODE_EMBEDDER=off

# -- OAuth authorization server (AUTH_PROVIDER stays "token") -----------------------
NEURALSCAPE_PUBLIC_URL=http://127.0.0.1:18199

# -- speaker-aware extraction -------------------------------------------------------
EXTRACTION_REQUIRE_SPEAKER=true
