# services: docling
# Profile: docling
# Brings the Docling extraction service up next to the stack and turns the
# Docling parser on, so PDF/Office uploads are converted by it (not the
# in-process MarkItDown fallback). The gate exports NS_HAVE_DOCLING=1 for it.
DOCLING_ENABLED=true
# Visual setup exemplars (ingest.visual-exemplars): the exemplar store on, and Docling asked
# to hand back the figures it finds. Needs the same EXEMPLAR_STORE_DIR volume on the API and
# the ingest worker (the compose files already share it).
EXEMPLAR_STORE_ENABLED=true
DOCLING_EXTRACT_IMAGES=true
