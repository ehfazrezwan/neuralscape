# Profile: cbm
# services: cbm-bridge
# mounts: <checkout>/neuralscape-service/knowledge -> /corpus/knowledge (read-only) on cbm-bridge
# The CBM code-intel bridge (compose profile `cbm`) is brought up next to the stack and the
# service's own `knowledge/` package is mounted into it, so the repo path below exists in
# BOTH the bridge and (for the read path) the API. The gate exports NS_HAVE_CBM_BRIDGE=1.
CBM_ENABLED=true
CBM_BRIDGE_URL=http://cbm-bridge:8200
CODE_REPOS='{"svc":"/corpus/knowledge"}'
