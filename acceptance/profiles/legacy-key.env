# Profile: legacy-key
# The deprecated shared API key (NEURALSCAPE_API_KEY) alongside per-user tokens, on the THROWAWAY campaign stack only.
# Defaults in the product are never changed by this file; it is the gate's input.
#
# Needs its OWN stack restart: setting a shared key changes the auth surface every other scenario runs on,
# so no other profile may share this stack, and this profile's run must not share one with them.
#
# Secrets: the key is not written here. The gate replaces `<generate:hex32>` with a freshly generated value
# (the same for the API and every worker) and, because of the header below, exports that generated value
# to the harness as NS_LEGACY_KEY. It is never written to a file or to the results.
# harness-env: NS_LEGACY_KEY=NEURALSCAPE_API_KEY
# exclusive: own-restart
#
# NEURALSCAPE_USER_TOKEN_SECRET stays as the gate already sets it: the acceptance users A and B keep their
# per-user tokens on this same stack. NEURALSCAPE_LEGACY_KEY_TRUST_BODY_USER_ID is left at its default (off).

NEURALSCAPE_API_KEY=<generate:hex32>
# The one identity the key acts as (fixed and disposable: the stack's volumes are throwaway per run).
NEURALSCAPE_API_KEY_USER_ID=acc-legacy
