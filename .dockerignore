graphiti/Zep-CLA.md
graphiti/Makefile
graphiti/Dockerfile
graphiti/docker-compose*.yml
graphiti/ellipsis.yaml
graphiti/depot.json
graphiti/conftest.py
graphiti/pytest.ini

# mem0 — keep only mem0/mem0/ and pyproject.toml
mem0/embedchain/
mem0/openmemory/
mem0/openclaw/
mem0/docs/
mem0/tests/
mem0/examples/
mem0/cookbooks/
mem0/evaluation/
mem0/mem0-ts/
