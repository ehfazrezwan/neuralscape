# Virtual environments
**/.venv/

# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo

# Environment files (secrets passed at runtime)
**/.env

# Version control
**/.git/
.gitignore

# Node
**/node_modules/

# graphiti — keep only graphiti_core/ and pyproject.toml
graphiti/.github/
graphiti/examples/
graphiti/tests/
graphiti/docs/
graphiti/images/
graphiti/mcp_server/
graphiti/server/
graphiti/spec/
