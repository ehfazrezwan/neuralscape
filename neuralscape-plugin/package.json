{
  "name": "neuralscape-plugin",
  "version": "2.9.1",
  "description": "Persistent agentic memory plugin for Claude Code and Claude Cowork",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ehfaz Rezwan",
    "email": "ehfaz.rezwan@gmail.com"
  },
