{
  "description": "NeuralScape memory hooks for OpenClaw — automatic conversation capture and end-of-session compilation. Install under ~/.openclaw/hooks/neuralscape/ (see the plugin README); the command paths below assume that location.",
  "hooks": {
    "message:received": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.openclaw/hooks/neuralscape/scripts/conversation-turn.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "message:sent": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.openclaw/hooks/neuralscape/scripts/conversation-turn.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "session:end": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.openclaw/hooks/neuralscape/scripts/session-end.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
