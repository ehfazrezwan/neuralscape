{
  "description": "NeuralScape memory hooks for OpenClaw — automatic conversation capture and end-of-session compilation",
  "hooks": {
    "message:sent": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/conversation-turn.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "session:end": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/session-summary.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
