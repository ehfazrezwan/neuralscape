# Neuralscape — local development environment template
#
# 1. Copy to .env:           cp .env.example .env
# 2. Fill in GOOGLE_API_KEY, and choose an auth option in the Auth section
#    below. Startup REFUSES until one auth option is set (fail-closed).
# 3. Adjust other settings only if you have a reason to.
#
# For production deployment behind a public domain, see .env.production
# instead — it adds REDIS_PASSWORD, NEURALSCAPE_API_KEY, DOMAIN, and tighter
# defaults.
#
# Every variable here is read by the service's settings: the Settings class in
# neuralscape-service/config.py, or an extension's settings (DREAMING_*,
# STRATEGY_SYNTHESIZER_*, and the conversation compiler's keys such as
# OBSIDIAN_VAULT_PATH). Keys marked "Compose-only" are read by docker compose for
# interpolation and never by the service. Names are case-insensitive. The same
# file works as the Compose project's .env (repository root) and as
# neuralscape-service/.env for a local `uv run` from that directory; there, the
# shell environment takes precedence over the file.
#
# neuralscape-service/config.py is the source of truth for every default. A line
# below that is commented out shows the default; uncomment it only to change it.
# The last sections list every setting that has no hand-written section above.

# ─── Required ──────────────────────────────────────────────────────

# Gemini API key. Get one at https://aistudio.google.com/apikey.
# Used by mem0's LLM + embedder, Graphiti's LLM + embedder + reranker.
GOOGLE_API_KEY=

# Optional hybrid decision paths (a third-party small-model decision API). All
# off by default; restart workers/API after changing flags. Each flag needs BOTH
# an endpoint and a key: with either empty the feature cannot activate and a
# startup warning is logged. The decision model selects source facts; ambiguous
# extraction still uses the original model. Embeddings and free-form synthesis
# are not replaced. Row text (rerank) and episode text (graph resolution) are
# sent to the endpoint when those flags are on; non-default sensitivity or
# visibility rows are never sent. See docs/neuralscape/28-hybrid-inference-evaluation.md.
# Connection (no defaults; each flag below needs BOTH endpoint and key). The
# endpoint must be https, or a loopback host; anything else is refused with a
# startup warning. Text that matches a sensitivity class is never sent by any
# of the extraction, rerank or graph paths.
HYBRID_INFERENCE_ENDPOINT=
HYBRID_INFERENCE_API_KEY=
HYBRID_INFERENCE_MODEL=
# Per-feature flags. Turning one on sends text to HYBRID_INFERENCE_ENDPOINT:
#   GRAPH       new/candidate entities+facts and the raw episode (+ previous episodes)
#   CATEGORIES  unfamiliar OKF type labels only
#   EXTRACTION  the user messages of each extraction window (unless gated)
#   RERANK      text + metadata of the top candidate rows
HYBRID_GRAPH_ENABLED=false
HYBRID_CATEGORIES_ENABLED=false
HYBRID_EXTRACTION_ENABLED=false
HYBRID_RERANK_ENABLED=false
# Confidence threshold for accepting a decision (0.5-1.0) and per-request timeout.
HYBRID_THRESHOLD=0.9
HYBRID_TIMEOUT_S=2.0
# Bounds waiting for decision-model extraction, not the subsequent Gemini fallback.
HYBRID_EXTRACTION_DEADLINE_S=2.5
# Rerank: how many top rows are scored (1-64) and the ranking policy sent with them.
HYBRID_RERANK_LIMIT=32
# Default: "Prefer direct evidence answering the query; respect explicit versions and dates in the query.
# Do not confuse topical overlap with an answer."
# HYBRID_RERANK_POLICY=

# Neo4j password (user: neo4j). REQUIRED and deliberately blank: docker-compose.yml
# has no default and refuses to start until you set a strong, unique value here
# (e.g. `openssl rand -hex 24`). Set it BEFORE the first `docker compose up`:
# Neo4j keeps the password it was first started with in its data volume.
NEO4J_PASSWORD=

# ─── Service URLs ──────────────────────────────────────────────────
#
# When you `docker compose up`, the values here are overridden inside the
# containers (REDIS_URL → redis://redis:6379 etc.) by docker-compose.yml.
# These values matter only when running the API/worker locally outside
# Docker (e.g. `uv run python main.py` against a partial docker stack).

REDIS_URL=redis://localhost:6379
# Seconds a process may serve a cached per-project knowledge config before
# re-reading it from Redis (a worker rewrite becomes visible within this bound).
# 0 re-checks on every read.
# KNOWLEDGE_CONFIG_CACHE_TTL_S=5.0
QDRANT_URL=http://localhost:6333
# Per-request timeout, in seconds, for every Qdrant call (qdrant-client's own default is ~5).
QDRANT_TIMEOUT=30
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=memory

# ─── Auth (required: pick ONE of the three options) ────────────────
#
# Auth is fail-closed. The service refuses to start until one of these is
# set:
#   1. NEURALSCAPE_USER_TOKEN_SECRET  (per-user tokens; recommended)
#   2. NEURALSCAPE_API_KEY            (legacy single shared key)
#   3. NEURALSCAPE_AUTH_DISABLED=true (no auth at all; trusted local
#      machine only; logs a WARNING at startup)
# On any shared or network-reachable host use option 1: without a secret
# your memory layer is open to anyone who can reach the port. See AUTH.md.

# Preferred: per-user HMAC tokens. The server signs tokens with this
# secret; each token carries a user_id the server trusts authoritatively
# (request body user_id is ignored). Issue tokens with:
#   docker exec neuralscape-neuralscape-1 \
#       python scripts/issue_user_token.py -u <user> --days 365
# Generate a fresh 32-byte base64 secret in PowerShell:
#   $b = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
NEURALSCAPE_USER_TOKEN_SECRET=

# Legacy: single shared API key (deprecated). Any bearer matching this exact
# string is accepted and acts as ONE user: NEURALSCAPE_API_KEY_USER_ID, or
# DEFAULT_USER_ID when that is empty. A request body/query user_id naming
# anyone else gets HTTP 400. Responses carry an X-Neuralscape-Deprecation
# header. Prefer the per-user token above. See AUTH.md.
NEURALSCAPE_API_KEY=
# The user the shared key acts as (default: DEFAULT_USER_ID). Set this to the
# user id your clients send before upgrading.
# NEURALSCAPE_API_KEY_USER_ID=
# Opt-out: let the shared key act as ANY user named in the request body (the
# old behaviour; logs a WARNING at startup). Default false.
# NEURALSCAPE_LEGACY_KEY_TRUST_BODY_USER_ID=true
# Revoke leaked per-user tokens: comma-separated SHA-256 digests printed by
# `python scripts/revoke_token.py`. Empty = none revoked. Always honoured (also
# while Redis is down). For revoking WITHOUT a restart use
# `python scripts/revoke_token.py --redis` (Redis set ns:auth:revoked_tokens).
# NEURALSCAPE_REVOKED_TOKENS=
# How often each API process re-reads the live Redis denylist (seconds; 0 = every
# request) = the worst-case delay before a live revocation is enforced.
# REVOCATION_REFRESH_INTERVAL_SECONDS=5
# Connect/read timeout (seconds) for that read; bounds the cost of a Redis outage.
# REVOCATION_REDIS_TIMEOUT_SECONDS=1
# Until this process has loaded the Redis revocation set once, per-user tokens get
# 503 + Retry-After (not 401). false = fail open on the Redis list (env list is
# always enforced). The first load is retried every REVOCATION_COLD_RETRY_SECONDS.
# REVOCATION_FAIL_CLOSED_ON_COLD_START=true
# REVOCATION_COLD_RETRY_SECONDS=1

# Explicit opt-out: run with NO authentication. Only for a trusted local
# machine where nothing else can reach the API port. Ignored when either
# secret above is set. Leave commented out unless you mean it.
# NEURALSCAPE_AUTH_DISABLED=true

# ─── OAuth connector (Claude Cowork / claude.ai) ───────────────────
#
# Public HTTPS base URL this service is reachable at from the internet
# (typically your cloudflared hostname). When this is set *together with*
# NEURALSCAPE_USER_TOKEN_SECRET, the service turns on a built-in OAuth 2.1
# Authorization Server so Claude Cowork / claude.ai can add Neuralscape as a
# custom MCP connector with a "Connect → log in" flow (the connector UI has
# no field for a static Bearer token, so OAuth is the only first-class path).
# Leave EMPTY for local dev / Claude Code CLI — OAuth discovery stays off and
# the .well-known/oauth-* endpoints return 404. No trailing slash. See COWORK.md.
NEURALSCAPE_PUBLIC_URL=
# OAuth token lifetimes (seconds). Anthropic silently refreshes, so the access
# token can be short. Defaults: 1h access, 30d refresh. Usually leave unset.
# OAUTH_ACCESS_TTL=3600
# OAUTH_REFRESH_TTL=2592000

# ─── Login provider (who the consent screen authenticates) ─────────
#
# Selects HOW a human proves identity at the OAuth "Connect → log in" step.
# The OAuth machinery above (DCR, codes, access/refresh tokens) is identical
# for every provider — only the login UX changes. Pre-issued admin HMAC tokens
# (issue_user_token.py) keep working as Bearer credentials regardless, so
# CLI/CI/e2e are unaffected. Per-deployment switch:
#   token    → paste an admin-issued HMAC token (default; needs nothing below)
#   google   → "Sign in with Google", gated by the env allowlist
#   supabase → "Sign in with Google" via Supabase, gated by Supabase's
#              Before-User-Created hook (+ optional env allowlist)
AUTH_PROVIDER=token

# When AUTH_PROVIDER is google/supabase, the consent screen ALSO shows an
# admin-token paste box by default, so tokens from issue_user_token.py keep
# working as a login option (service accounts, CI, users without a Google
# identity). Set false for a provider-only login screen. Ignored for
# AUTH_PROVIDER=token (the paste box is the only mechanism there).
# AUTH_ALLOW_TOKEN_PASTE=true

# Identity: verified email → Neuralscape user_id. Unmapped emails are slugified
# (user_id can't contain "@"; e.g. a@example.com → a-example.com).
# Map known users to existing ids to preserve their memories. Comma-separated
# "email:user_id" pairs.
# AUTH_IDENTITY_MAP=alice@example.com:alice,ops@example.com:ops-bot

# Email allowlist — the gate for AUTH_PROVIDER=google (an optional extra gate
# for supabase). A login passes when the verified email's DOMAIN is allowed OR
# the exact ADDRESS is allowed. Both comma-separated, case-insensitive. An
# empty allowlist denies everyone (fail-closed).
# AUTH_ALLOWED_DOMAINS=example.com
# AUTH_EMAIL_ALLOWLIST=guest@gmail.com,contractor@example.com

# Optional: restrict which hosts an OAuth client may register as a redirect
# target. Comma-separated, case-insensitive, "host" or "host:port" (a bare host
# matches the default https port only). Empty (default) = any https redirect.
# Loopback hosts (127.0.0.1, ::1, localhost) stay allowed for native clients.
# Checked at /oauth/register and again at /oauth/authorize. Set it to the hosts
# you really connect from (e.g. the connector's callback host).
# OAUTH_REDIRECT_HOST_ALLOWLIST=claude.ai

# ── AUTH_PROVIDER=google ── (also requires NEURALSCAPE_PUBLIC_URL + _SECRET)
# Google Cloud → Credentials → OAuth client (Web). Authorized redirect URI:
#   {NEURALSCAPE_PUBLIC_URL}/oauth/google/callback
# Consent screen: External + publish (scopes openid/email/profile are
# non-sensitive, so no Google verification review is needed).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ── AUTH_PROVIDER=supabase ── (also requires NEURALSCAPE_PUBLIC_URL + _SECRET)
# Add a Supabase Google provider; in the dashboard set the redirect allow-list
# to include {NEURALSCAPE_PUBLIC_URL}/oauth/supabase/callback. Manage who may
# sign up with a Before-User-Created hook + a signup_email_domains table.
# SUPABASE_URL=https://YOURPROJECT.supabase.co
# SUPABASE_ANON_KEY=
# Verify the returned session JWT: set the legacy HS256 secret, OR leave empty
# to verify against the project's asymmetric JWKS (derived from SUPABASE_URL).
# SUPABASE_JWT_SECRET=

# ─── Gemini model overrides (optional) ─────────────────────────────

# GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_LLM_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_EMBEDDER_MODEL=gemini-embedding-001
# Vector length Graphiti stores in Neo4j (default 1024 = existing data). See docs/GRAPH_EMBEDDING_DIMENSION.md
GRAPHITI_EMBEDDING_DIM=1024

# ─── MCP transport ─────────────────────────────────────────────────
#
# stdio — the MCP server runs as a subprocess (good for Claude Desktop's
#         direct stdio config).
# http  — mounts the MCP server on the API at /mcp/ as Streamable HTTP.
#         Required when the neuralscape-plugin's bundled .mcp.json is in
#         use, since it points at <URL>/mcp/. docker-compose.yml sets this
#         to http for both API and worker.
MCP_TRANSPORT=stdio

# ─── Conversation compiler / Obsidian vault ────────────────────────

# Host path the conversation_compiler extension writes notes into
# (Daily logs, Sessions, Projects, Decisions, Research, category folders).
# In Docker this is /data/vault inside the container, bind-mounted from
# ${OBSIDIAN_VAULT_PATH:-./vault} on the host.
OBSIDIAN_VAULT_PATH=./vault

# ─── Logging ───────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json    — machine-parseable; the default and what production should use
# console — coloured + human-friendly; uncomment for local development
# LOG_FORMAT=json

# ─── ARQ / dedup tuning (optional) ─────────────────────────────────

ARQ_QUEUE_NAME=neuralscape:queue
ARQ_MAX_RETRIES=3
ARQ_JOB_TIMEOUT=300

DEDUP_SIMILARITY_THRESHOLD=0.95
DEDUP_BATCH_SIZE=100

# LLM retry budget for transient 503/429 from Gemini (exponential backoff).
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0

# ─── Identity defaults (rarely needed) ─────────────────────────────

DEFAULT_USER_ID=default_user

# ─── Extensions ────────────────────────────────────────────────────

# Comma-separated dotted paths to extra extension modules to auto-load
# alongside the built-in conversation_compiler. Leave empty unless
# you've written one.
NEURALSCAPE_EXTENSIONS=

# ─── Dreaming (memory consolidation) ──────────────────────────────
#
# The dreaming extension reads DREAMING_* keys; docker-compose.yml passes
# DREAMING_ENABLED to the API and the graph worker. Off by default. See
# docs/DREAMING_MODE_SPEC.md for what each phase does. Its other keys are
# listed (at their defaults) in the last section of this file.
# DREAMING_ENABLED=false

# ─── Third-party library telemetry ─────────────────────────────────
#
# The vendored mem0 and Graphiti libraries send anonymous usage telemetry to
# an external analytics host unless it is disabled. Neuralscape defaults both
# to off (code, image and compose). Uncomment to opt in: here for
# `docker compose`, or in neuralscape-service/.env for a local run from that
# directory (the service applies these two keys from that file before the
# libraries load). A value exported in the shell takes precedence.
# MEM0_TELEMETRY=true
# GRAPHITI_TELEMETRY_ENABLED=true

# ─── Cloudflare tunnel (deploy-only) ───────────────────────────────
#
# Only relevant when running the optional ``tunnel`` compose profile
# (``docker compose --profile tunnel up -d cloudflared``). Provision
# a tunnel in the Cloudflare dashboard (Zero Trust → Networks →
# Tunnels), copy the connector token, and paste it here. Cloudflared
# joins the default compose network and routes incoming traffic to
# ``neuralscape:8199`` based on the public hostname configured in the
# dashboard.
# Compose-only.
CLOUDFLARE_TUNNEL_TOKEN=

# ─── Data-layer connectors: MCP stdio transport ────────────────────
# Comma-separated exact command lines (shell-quoted; an entry cannot contain a
# comma) an MCP connector may spawn on the worker over the stdio transport. Empty
# (default) disables stdio entirely; HTTP MCP connectors are unaffected.
# WARNING: allowlisting a general interpreter (python, node, npx, sh) is the
# same as allowing arbitrary code execution on the worker.
# CONNECTOR_STDIO_COMMANDS=/usr/local/bin/my-mcp-server --readonly

# ─── Data-layer connectors: destination policy (SSRF guard) ────────
# Connectors that fetch a URL (generic_rest, MCP over http) may only reach public
# hosts over https: a host that resolves to loopback, private, link-local (cloud
# metadata) or other reserved addresses is refused at registration and at sync.
# Comma-separated exact hostnames (optionally host:port) to exempt, e.g. an
# internal MCP server. A bare host covers ports 80 and 443 only; any other port
# needs host:port. Allowlisted hosts may also use plain http, but link-local and
# cloud-metadata addresses (169.254.0.0/16, fe80::/10, 168.63.129.16) stay refused.
# Empty (default) exempts nothing.
# CONNECTOR_ALLOWED_HOSTS=internal-mcp.example.internal:8080

# Upper bound (seconds) on one Graphiti bridge call (mem0 adapter). Default: 960
# (the 900 s graph/ingest worker job_timeout plus a 60 s margin; unbounded before).
# A hung Neo4j/LLM call is cancelled and raises TimeoutError instead of parking a
# worker slot. Keep it above the longest worker job_timeout that runs graph work.
# Process environment only (read by the vendored adapter, not by Settings): export it;
# a value in the service .env is not read.
# GRAPHITI_BRIDGE_TIMEOUT_S=960

# Compose-only: the three ARQ workers write a heartbeat from their event loop and carry
# the autoheal label, so a worker whose loop is blocked for >= 5 minutes is restarted.
# Set to false to opt out (a wedged worker then stays up, as before).
# WORKER_AUTOHEAL=true

# ═══ Every other setting, at its default ═══════════════════════════
#
# One line per Settings field not documented above (taken from config.py's
# defaults; tests/test_settings_parity.py keeps this file and config.py in step).
# Uncomment a line only to change it. What each setting does is documented next
# to its field in neuralscape-service/config.py.


# LLM gateway: route the LLM + embedder through an OpenAI-compatible gateway instead of Google AI Studio.
# Needs LLM_GATEWAY_BASE_URL and LLM_GATEWAY_API_KEY (e.g. https://llm-gateway.example.com). The model tags default to the
# provider-prefixed form the gateway expects. LLM_GATEWAY_GRAPHITI_ENABLED decides whether the graph side routes through it too.
# LLM_GATEWAY_ENABLED=false
# LLM_GATEWAY_BASE_URL=
# LLM_GATEWAY_API_KEY=
# LLM_GATEWAY_LLM_MODEL=google-vertex/gemini-3.1-flash-lite
# LLM_GATEWAY_LLM_FALLBACK_MODEL=google-vertex/gemini-2.5-flash
# LLM_GATEWAY_EMBEDDER_MODEL=google-vertex/gemini-embedding-001
# LLM_GATEWAY_GRAPHITI_MODEL=google-vertex/gemini-3.1-flash-lite
# LLM_GATEWAY_GRAPHITI_ENABLED=false

# EMBEDDER_MAX_BATCH_SIZE=0

# STORE_RAW_EPISODE_CONTENT=true

# UPDATE_COMMUNITIES=false

# QDRANT_ON_DISK=true
# QDRANT_PATH=~/.neuralscape/qdrant
# QDRANT_COLLECTION=neuralscape_memories

# GRAPH_QUEUE_NAME=neuralscape:graph

# INGEST_QUEUE_NAME=neuralscape:ingest

# ARQ_MAX_JOBS=10

# GRAPH_MAX_JOBS=4

# INGEST_MAX_JOBS=3

# TO_THREAD_MAX_WORKERS=0

# ENGINE_PGVECTOR_ENABLED=false
# ENGINE_PGVECTOR_DSN=
# ENGINE_PGVECTOR_SCHEMA=ns_engine
# ENGINE_PGVECTOR_DIMENSIONS=0
# ENGINE_ROUTING_ENABLED=false
# Serve a plain search (no category, scope, domain, observation type, concepts, memory kind or workspace filter,
# no standard tier) from the engine, scoped to the caller and project; it skips the graph and lexical legs and the
# rerank, and a project search does not include global rows. Any other search uses the normal path.
# ENGINE_ROUTING_RECALL_ENABLED=false
# ENGINE_ROUTING_QDRANT_COLLECTION=neuralscape_engine_projection
# ENGINE_ROUTING_DIMENSIONS=0
# ENGINE_ROUTING_ROLLBACK_WINDOW_SECONDS=0.0

# Content-free usage events for provider calls, stored durably. The API and every worker queue open the store;
# use postgres when they run in separate containers. Fail-closed: with this on and the store unreachable, the API
# and every worker refuse to start. There is no retention: usage_events and usage_gaps keep every row until you delete it.
# USAGE_STORE_ENABLED=false
# USAGE_STORE_BACKEND=sqlite
# USAGE_STORE_SQLITE_PATH=data/usage.sqlite3
# USAGE_STORE_POSTGRES_DSN=

# Support-aware graph removal on delete and correction (an edge another live episode supports is kept).
# GRAPH_SUPPORT_AWARE_REMOVAL_ENABLED=false
# Remove the graph episode written for a memory that was deleted while it was being enriched.
# GRAPH_DELETE_RACE_CLEANUP_ENABLED=false

# Route every Gemini client (including mem0/Graphiti's own) to this http(s) endpoint; empty = the SDK default.
# NS_GEMINI_BASE_URL=

# Graph-contradiction supersession: when graph enrichment invalidates an edge, tombstone the vector row it came from
# (reversible). Off: the write path is unchanged. MIN_SIMILARITY and MARGIN gate which row of a multi-row episode is chosen.
# GRAPH_SUPERSESSION_ENABLED=false
# GRAPH_SUPERSESSION_MIN_SIMILARITY=0.85
# GRAPH_SUPERSESSION_MARGIN=0.05
# GRAPH_SUPERSESSION_PARTIAL_MIN_SIMILARITY=0.85
# GRAPH_LEG_BUDGET_ENABLED=false
# GRAPH_LEG_BUDGET_S=4.0

# DEDUP_SEMANTIC_TOMBSTONE_ENABLED=false

# Hours (0-23, UTC) the dedup cron fires: comma list or JSON list; blank = default; [] disables it.
# DEDUP_CRON_HOURS=0,6,12,18

# REINFORCEMENT_BOOST_K=0.05

# ASK_TIMEOUT_MINIMAL_S=20
# ASK_TIMEOUT_LOW_S=40
# ASK_TIMEOUT_MEDIUM_S=75
# ASK_TIMEOUT_HIGH_S=120

# QUEUE_STATUS_WINDOW_S=3600

# WEBHOOK_QUEUE_EMPTY_URL=

# EVENT_STREAM_ENABLED=true

# Token-savings meter.
# SAVINGS_METER_ENABLED=true
# SAVINGS_TOKENIZER=o200k_base
# SAVINGS_LEDGER_MAXLEN=100000
# SAVINGS_REDERIVATION_MULTIPLIER=10.0
# SAVINGS_CODE_NAV_AVOIDED_READ_TOKENS_PER_FILE=1500
# SAVINGS_BOUNCE_WINDOW_SECONDS=900
# SAVINGS_TASK_ROLLUP_TTL_SECONDS=604800

# Rolling session summaries.
# SESSION_SUMMARY_ENABLED=true
# SESSION_SUMMARY_SHORT_EVERY=20
# SESSION_SUMMARY_LONG_EVERY=60
# SESSION_SUMMARY_SHORT_MAX_TOKENS=1000
# SESSION_SUMMARY_LONG_MAX_TOKENS=4000
# SESSION_BUFFER_MAX_MESSAGES=400
# SESSION_TTL_DAYS=30

# EXTRACTION_WINDOW_MESSAGES=30
# EXTRACTION_WINDOW_OVERLAP=2

# KNOWN_PROJECT_SLUGS=neuralscape

# ASK_EPISODE_EVIDENCE=true

# GRAPH_EPISODE_RECALL_ENABLED=true
# GRAPH_GROUP_ID_INJECTIVE_ENABLED=false

# ASK_SECOND_CHANCE=true

# EXTRACTION_INSTRUCTIONS_ENABLED=true
# EXTRACTION_INSTRUCTIONS_MAX_TOKENS=2000
# EXTRACTION_REQUIRE_SPEAKER=false

# Data-layer connectors (needs NEURALSCAPE_VAULT_KEY below).
# CONNECTORS_ENABLED=false

# NEURALSCAPE_VAULT_KEY=

# CONNECTOR_SYNC_CRON_HOURS=6
# CONNECTOR_STDIO_COMMANDS=

# DOCLING_ENABLED=true
# DOCLING_URL=http://docling:5001
# DOCLING_TIMEOUT_S=120

# INGEST_MAX_FILE_MB=25
# INGEST_MAX_FILES=200
# INGEST_MAX_ARCHIVE_UNCOMPRESSED_MB=200
# Orphan-artifact sweep (ingest worker cron). Off by default (it deletes files); dry-run reports only.
# ARTIFACT_GC_ENABLED=false
# ARTIFACT_GC_DRY_RUN=true
# ARTIFACT_GC_GRACE_DAYS=7
# INGEST_MAX_REQUEST_MB=500

# Persist uploaded files as artifacts on a volume.
# INGEST_STORAGE_ENABLED=true
# INGEST_STORAGE_DIR=~/.neuralscape/ingest

# OKF export (GET /v1/export/okf): most memories read per pool in one export; a larger
# pool is reported as truncated (headers + the bundle's log.md), never cut silently.
# OKF_EXPORT_MAX_MEMORIES=50000

# EXEMPLAR_STORE_ENABLED=false
# EXEMPLAR_STORE_DIR=~/.neuralscape/exemplars

# DOCLING_EXTRACT_IMAGES=false

# EXEMPLAR_VISION_MODEL=

# CODE_GRAPH_JSON_PATH=

# Native code-intel repos: JSON object or name=/abs/path,name2=/abs/path2; blank = none.
# CODE_REPOS=

# CBM_ENABLED=false
# CBM_BRIDGE_URL=http://cbm-bridge:8200

# CODE_NATIVE_ENABLED=false
# CODE_EMBEDDER=local
# CODE_EMBEDDER_MODEL=jinaai/jina-embeddings-v2-base-code
# CODE_EMBEDDER_QUERY_PREFIX=
# CODE_LOCATE_LEXICAL_CARDS=true
# CODE_NEIGHBORS_RESOLVER=jedi
# CODE_RESOLVER_URL=http://resolver-svc:8201
# CODE_INDEX_EMBEDDINGS=false
# CODE_GRAPH_EXTRACTED_CONFIDENCE=0.9
# CODE_GRAPH_INFERRED_CONFIDENCE=0.6
