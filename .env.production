# Neuralscape — production environment template
#
# Copy to .env on your deployment host. Used together with
# docker-compose.prod.yml (Caddy + private internal network + Redis password)
# and Caddyfile (which expands ${DOMAIN} for automatic TLS).
#
# Treat this file as a secret — chmod 600, never commit, never log.
#
# Every variable below maps to a field on neuralscape-service/config.py or
# is consumed by docker-compose.prod.yml / Caddyfile directly.

# ─── REQUIRED ──────────────────────────────────────────────────────

# Gemini API key. Use a project-scoped key with billing enabled.
GOOGLE_API_KEY=

# Neo4j auth (default user is neo4j). Pick something strong; this becomes
# both NEO4J_AUTH inside the container and the bearer Cypher uses.
NEO4J_PASSWORD=

# Redis password. docker-compose.prod.yml passes --requirepass and the
# REDIS_URL the API + worker use is redis://:${REDIS_PASSWORD}@redis:6379.
REDIS_PASSWORD=

# Bearer token enforced on all REST + MCP endpoints (except /health).
# WITHOUT THIS your memory layer is wide open to anyone who can reach the
# host. Generate something strong (e.g. `openssl rand -hex 32`).
NEURALSCAPE_API_KEY=

# Public domain Caddy issues a TLS cert for. Must point DNS at this host.
DOMAIN=memory.yourdomain.com

# ─── Production tuning ─────────────────────────────────────────────

NEO4J_DATABASE=memory

# Mounted in docker-compose.prod.yml at neuralscape-net's /mcp/ via Caddy
# proxy. The plugin's bundled .mcp.json connects to https://${DOMAIN}/mcp/.
MCP_TRANSPORT=http

# Model overrides — keep current model names so you can roll forward
# without editing compose.
SMALL_MODEL_NAME=gemini-3-flash-preview
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ARQ / dedup. Production defaults; tune if you see queue backup.
ARQ_MAX_RETRIES=3
ARQ_JOB_TIMEOUT=300
DEDUP_SIMILARITY_THRESHOLD=0.95

# JSON logging in production for log aggregation (CloudWatch, Loki, etc.).
LOG_LEVEL=INFO
LOG_FORMAT=json

# Where the conversation_compiler writes vault notes inside the container.
# docker-compose.prod.yml does NOT bind-mount a host directory by default,
# so vault notes are ephemeral. To persist them, add a volume mount on the
# neuralscape and neuralscape-worker services pointing at this path.
OBSIDIAN_VAULT_PATH=/data/vault
