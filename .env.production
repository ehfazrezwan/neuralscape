# Neuralscape — production environment template
#
# Copy to .env on your deployment host. Used as an overlay on the base file:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
# docker-compose.prod.yml adds Caddy (expands ${DOMAIN} in the Caddyfile for
# automatic TLS) and a Redis password; no database or app port is published.
#
# Treat this file as a secret — chmod 600, never commit, never log.
#
# Every variable below maps to a field on neuralscape-service/config.py or
# is consumed by docker-compose.prod.yml / Caddyfile directly.

# ─── REQUIRED ──────────────────────────────────────────────────────

# Gemini API key. Use a project-scoped key with billing enabled.
GOOGLE_API_KEY=

# Neo4j auth (default user is neo4j). Pick something strong; this becomes
# both NEO4J_AUTH inside the container and the bearer Cypher uses.
NEO4J_PASSWORD=

# Redis password. docker-compose.prod.yml passes --requirepass and the
# REDIS_URL the API + worker use is redis://:${REDIS_PASSWORD}@redis:6379.
REDIS_PASSWORD=

# Auth is fail-closed: startup refuses until one option is set (see AUTH.md).
# Prefer per-user tokens: a signing secret, e.g. `openssl rand -base64 32`.
# NEURALSCAPE_API_KEY (one shared key) still works but is legacy.
NEURALSCAPE_USER_TOKEN_SECRET=
# NEURALSCAPE_API_KEY=

# Public domain Caddy issues a TLS cert for. Must point DNS at this host.
DOMAIN=memory.yourdomain.com

# ─── Production tuning ─────────────────────────────────────────────

NEO4J_DATABASE=memory

# The API serves MCP at /mcp/ behind Caddy. The plugin's bundled .mcp.json
# connects to https://${DOMAIN}/mcp/. (The base compose already sets this.)
MCP_TRANSPORT=http

# Model overrides. Unset = the compose defaults (the same models the tests and
# the dev stack use). GEMINI_LLM_MODEL replaces the old SMALL_MODEL_NAME, which
# nothing reads any more.
# GEMINI_LLM_MODEL=
EMBEDDING_MODEL_NAME=gemini-embedding-001

# ARQ / dedup. Production defaults; tune if you see queue backup.
ARQ_MAX_RETRIES=3
ARQ_JOB_TIMEOUT=300
DEDUP_SIMILARITY_THRESHOLD=0.95

# JSON logging in production for log aggregation (CloudWatch, Loki, etc.).
LOG_LEVEL=INFO
LOG_FORMAT=json

# Vault notes (conversation_compiler, dreaming) are written to /data/vault inside
# every container. compose bind-mounts the HOST directory below there (default
# ./vault next to the compose file), so they persist on the host. This is a host
# path, not a container path: leave it unset unless you want another directory.
# OBSIDIAN_VAULT_PATH=/srv/neuralscape/vault
